# Configuración del Servidor
PORT=3000
NODE_ENV=development

# Configuración de Base de Datos (Sequelize)
# Opciones para DB_DIALECT: postgres | mysql | sqlite
DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=control_labs_sena
DB_USER=postgres
DB_PASSWORD=tu_contraseña_aqui
DB_STORAGE=./database.sqlite

# Configuración de Autenticación y JWT
JWT_SECRET=sena_control_labs_jwt_secret_key_2026_super_segura
JWT_EXPIRES_IN=8h

# Configuración de Terceros - Google OAuth 2.0
GOOGLE_CLIENT_ID=tu_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback
